# Copy to .env and fill in. .env is gitignored.

# Postgres connection string. Local install example:
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/luxury_table_booking

# API server port
PORT=5000

# Optional — defaults shown
# RECEIPT_PREFIX=TLD
# VENUE_TIME_ZONE=Asia/Bangkok

# Vite mockup sandbox. HOST=:: is needed on Windows so `localhost` (IPv6) connects.
# PORT=5173
# BASE_PATH=/
# HOST=::
